# Official DeepSeek API. Put your key in the project-local .env, never in chat.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# VPN: auto respects enabled system/env proxy; direct supports VPN TUN.
# HTTP(S) proxy requires Node.js 24.14+. Keep credentials local.
LLM_NETWORK_MODE=auto
# LLM_PROXY_URL=http://127.0.0.1:7890
