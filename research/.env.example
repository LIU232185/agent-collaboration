# Copy to research/.env. This does not use the old Node workbench .env.
MODE=demo
STORAGE=sqlite
CONTEXT_BUDGET_BYTES=6000

# For a real run set MODE=live and STORAGE=postgres.
# Use a LiteLLM gateway with OpenAI-compatible model aliases.
DATABASE_URL=postgresql://research:research_local@127.0.0.1:5438/research
LLM_MODEL=openai/research-analyst
CRITIC_MODEL=openai/research-critic
LLM_API_BASE=http://127.0.0.1:4000/v1
LLM_API_KEY=
EMBEDDING_MODEL=openai/research-embedding
EMBEDDING_DIMS=1536
MEM0_ENABLED=false

# Supports an external or self-hosted Langfuse service; not provisioned by compose.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
